<main class="admin-page admin-login-page">
  <section class="admin-card admin-login-card">

    <p class="eyebrow">
      METALFORMA CNC
    </p>

    <h1>
      Acceso administrativo
    </h1>

    <p>
      Ingresá al panel de administración.
    </p>

    {{#if error}}
      <div class="alert error">
        {{error}}
      </div>
    {{/if}}

    <form
      method="POST"
      action="/admin/login"
      class="admin-form"
    >
      <label for="email">
        Correo electrónico
      </label>

      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
      />

      <label for="password">
        Contraseña
      </label>

      <input
        id="password"
        name="password"
        type="password"
        required
        autocomplete="current-password"
      />

      <button type="submit">
        Iniciar sesión
      </button>
    </form>

    <a
      class="back-link"
      href="http://localhost:3002"
    >
      Volver al sitio público
    </a>

  </section>
</main>